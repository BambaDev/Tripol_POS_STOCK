{
  "Gdpr": {
    "Enabled": true,
    "Version": "1.0.0",
    "LastUpdated": "2026-06-10",

    "FieldEncryption": {
      "Enabled": true,
      "Algorithm": "AES-256-GCM",
      "KeyRotationDays": 90,
      "AutoEncryptNewFields": true
    },

    "AuditTrail": {
      "MaskPii": true,
      "LogAccessAttempts": true,
      "RetentionDays": 1095
    },

    "DataRetention": {
      "EnforceRetentionPolicies": true,
      "AutoPurgingEnabled": false,
      "PurgeSchedule": "0 3 * * *",
      "Policies": {
        "Customer": {
          "RetentionDays": 2555,
          "RetentionBasis": "Tax and accounting legal requirement (7 years)",
          "AnonymizeAfterRetention": true
        },
        "Employee": {
          "RetentionDays": 1825,
          "RetentionBasis": "Labor law requirement (5 years after employment end)",
          "AnonymizeAfterRetention": true
        },
        "Transaction": {
          "RetentionDays": 3650,
          "RetentionBasis": "Accounting and tax legal requirement (10 years)",
          "AnonymizeAfterRetention": false,
          "PreserveForAudit": true
        },
        "AuditTrail": {
          "RetentionDays": 1095,
          "RetentionBasis": "Security monitoring (3 years)",
          "AnonymizeAfterRetention": false
        },
        "EmployeeHealth": {
          "RetentionDays": 1825,
          "RetentionBasis": "Medical records (5 years post-employment)",
          "AnonymizeAfterRetention": true,
          "RequireExplicitConsent": true
        }
      }
    },

    "AnonymizationRules": {
      "DefaultStrategy": "Placeholder",
      "Strategies": {
        "Placeholder": {
          "FirstName": "DELETED_USER",
          "LastName": "ANONYMIZED",
          "FullName": "DELETED USER",
          "Email": "deleted_{id}@anonymized.local",
          "Phone": null,
          "Address": null
        },
        "Hash": [
          "Phone",
          "Email",
          "Address"
        ],
        "Delete": [
          "Image",
          "HealthCondition",
          "Notes",
          "BloodGroup",
          "NoCard",
          "NoPass",
          "SpecialMarque"
        ],
        "Preserve": [
          "Id",
          "CreatedAt",
          "UpdatedAt",
          "Code"
        ]
      }
    },

    "ConsentManagement": {
      "Enabled": true,
      "RequireExplicitConsentFor": [
        "Marketing",
        "Analytics",
        "ThirdPartySharing",
        "Biometric",
        "HealthData"
      ],
      "DefaultConsent": false,
      "ConsentExpiryDays": 730
    },

    "DataSubjectRights": {
      "RightOfAccess": {
        "Enabled": true,
        "ExportFormats": [
          "JSON",
          "PDF",
          "CSV"
        ],
        "MaxResponseDays": 30,
        "IncludeAuditTrail": true
      },
      "RightToErasure": {
        "Enabled": true,
        "MaxResponseDays": 30,
        "RequireApproval": true,
        "ApproverRole": "Admin",
        "CreateBackup": true,
        "PreserveForLegalObligation": true
      },
      "RightToRectification": {
        "Enabled": true,
        "RequireVerification": true,
        "LogChanges": true
      },
      "RightToPortability": {
        "Enabled": true,
        "ExportFormat": "JSON",
        "IncludeRelatedData": true
      },
      "RightToObject": {
        "Enabled": true,
        "AllowMarketingOptOut": true,
        "AllowAnalyticsOptOut": true
      }
    },

    "DataBreach": {
      "AutoNotification": false,
      "NotificationDeadlineHours": 72,
      "SupervisoryAuthority": {
        "Name": "CNIL (France) or local DPA",
        "Email": "data-protection@authority.local",
        "RequireNotification": true
      },
      "DataSubjectNotification": {
        "RequireNotification": true,
        "ThresholdRecords": 100,
        "NotifyImmediately": true
      }
    },

    "Security": {
      "EncryptionAtRest": true,
      "EncryptionInTransit": true,
      "MinimumPasswordStrength": "Strong",
      "TwoFactorAuthenticationRequired": false,
      "SessionTimeout": 1440,
      "MaxLoginAttempts": 5,
      "LockoutDuration": 15
    },

    "ThirdPartyProcessors": {
      "Stripe": {
        "Name": "Stripe Payment Processing",
        "DataProcessingAgreement": true,
        "DataTransferMechanism": "Standard Contractual Clauses",
        "DataCategories": [
          "PaymentCard",
          "Email",
          "TransactionHistory"
        ],
        "ConsentRequired": true
      },
      "Twilio": {
        "Name": "Twilio SMS Service",
        "DataProcessingAgreement": true,
        "DataTransferMechanism": "Standard Contractual Clauses",
        "DataCategories": [
          "Phone",
          "MessageContent"
        ],
        "ConsentRequired": true
      }
    },

    "ComplianceChecks": {
      "RunAutomaticAudits": true,
      "AuditFrequencyDays": 30,
      "Checks": [
        "UnencryptedSensitiveFields",
        "ExpiredConsents",
        "RetentionPolicyViolations",
        "UnauthorizedDataAccess",
        "MissingDPA",
        "UnmaskedPiiInLogs"
      ]
    },

    "DataMinimization": {
      "Enabled": true,
      "OnlyCollectNecessaryData": true,
      "RegularReviewRequired": true,
      "ReviewFrequencyDays": 180
    },

    "LawfulBasis": {
      "DefaultBasis": "Consent",
      "DocumentedBases": {
        "EmployeeData": "Contract",
        "CustomerData": "Consent",
        "TransactionData": "Contract",
        "MarketingData": "Consent",
        "TaxData": "Legal Obligation",
        "HealthData": "Explicit Consent",
        "BiometricData": "Explicit Consent"
      }
    },

    "InternationalTransfers": {
      "Enabled": false,
      "Countries": [],
      "Mechanism": "Standard Contractual Clauses",
      "ApprovalRequired": true
    },

    "PrivacyByDesign": {
      "DefaultToMinimalData": true,
      "EncryptByDefault": true,
      "PseudonymizationEnabled": true,
      "AccessControlsEnforced": true
    },

    "Reporting": {
      "GenerateComplianceReports": true,
      "ReportFrequency": "Monthly",
      "Recipients": [
        "DPO",
        "Admin",
        "Legal"
      ],
      "IncludeMetrics": [
        "DataSubjectRequests",
        "ConsentRates",
        "DataBreaches",
        "RetentionCompliance",
        "EncryptionCoverage"
      ]
    }
  }
}
